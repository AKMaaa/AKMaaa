---
import { withBase } from '../library/paths';
import '../styles/theme.css';

type NavId =
	| 'home'
	| 'news'
	| 'research'
	| 'works'
	| 'photographs'
	| 'hobbies'
	| 'profile'
	| 'contact';

type Props = {
	title: string;
	description?: string;
	current: NavId;
	pageLabel?: string;
};

const {
	title,
	description = 'Maeda Akira — portfolio, research, and works.',
	current,
	pageLabel,
} = Astro.props;

const homeHref = withBase('/');
const nav = [
	{ id: 'news' as const, href: withBase('/news/'), label: 'news' },
	{ id: 'research' as const, href: withBase('/research/'), label: 'research' },
	{ id: 'works' as const, href: withBase('/works/'), label: 'works' },
	{ id: 'photographs' as const, href: withBase('/photographs/'), label: 'photographs' },
	{ id: 'hobbies' as const, href: withBase('/hobbies/'), label: 'hobbies' },
	{ id: 'profile' as const, href: withBase('/profile/'), label: 'profile' },
	{ id: 'contact' as const, href: withBase('/contact/'), label: 'contact' },
];
---

<!doctype html>
<html lang="ja" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="icon" href={withBase('/favicon.ico')} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Shippori+Mincho:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="shell">
			<header class="side">
				<button
					type="button"
					class="nav-backdrop"
					hidden
					aria-label="メニューを閉じる"
					data-nav-close
				></button>
				<div class="nav-shell" data-nav-shell>
					<div class="nav-shell-bar">
						<div class="brand">
							<a class="brand-ja" href={homeHref}>前田 祥</a>
							<p class="brand-en">Maeda Akira</p>
						</div>
						<button
							type="button"
							class="nav-toggle"
							aria-expanded="false"
							aria-controls="site-nav"
							data-nav-toggle
						>
							<span class="nav-toggle-icon" aria-hidden="true">
								<span class="nav-toggle-line nav-toggle-line-a"></span>
								<span class="nav-toggle-line nav-toggle-line-b"></span>
							</span>
							<span class="nav-toggle-label">menu</span>
						</button>
					</div>
					<div class="nav-shell-grow">
						<div class="nav-shell-grow-inner">
							<nav id="site-nav" class="nav" aria-label="Primary">
								<ul>
									{
										nav.map((item) => (
											<li>
												<a
													href={item.href}
													aria-current={item.id === current ? 'page' : undefined}
												>
													{item.label}
												</a>
											</li>
										))
									}
								</ul>
							</nav>
						</div>
					</div>
				</div>

				<p class="copyright">
					Copyright ©<br />
					Maeda Akira<br />
					All rights reserved.
				</p>
			</header>

			<main class="main" data-home={current === 'home' ? '' : undefined}>
				{pageLabel && <h1 class="page-label">{pageLabel}</h1>}
				<slot />
			</main>
		</div>
		<script>
			const shell = document.querySelector<HTMLElement>('[data-nav-shell]');
			const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
			const backdrop = document.querySelector<HTMLButtonElement>('[data-nav-close]');
			const desktop = window.matchMedia('(min-width: 768px)');

			const setOpen = (open: boolean) => {
				if (!shell || !toggle || !backdrop || desktop.matches) return;
				shell.classList.toggle('is-open', open);
				toggle.classList.toggle('is-open', open);
				toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
				backdrop.hidden = !open;
				document.body.classList.toggle('is-nav-open', open);
			};

			toggle?.addEventListener('click', () => {
				setOpen(!shell?.classList.contains('is-open'));
			});
			backdrop?.addEventListener('click', () => setOpen(false));
			shell?.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => setOpen(false));
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') setOpen(false);
			});
			desktop.addEventListener('change', () => setOpen(false));
		</script>
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	img {
		display: block;
		max-width: 100%;
		height: auto;
	}

	ul,
	ol {
		margin: 0;
		padding: 0;
	}

	.shell {
		min-height: 100vh;
	}

	.side {
		padding: 0;
		text-align: left;
	}

	.nav-backdrop {
		all: unset;
		position: fixed;
		inset: 0;
		z-index: 70;
		cursor: pointer;
	}

	.nav-shell {
		position: fixed;
		z-index: 80;
		top: 0.85rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: stretch;
		width: min(18.5rem, calc(100vw - 2rem));
		overflow: hidden;
		pointer-events: auto;
		background: #ffffff;
		border: 1px solid rgba(0, 0, 0, 0.08);
		border-radius: 1.35rem;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
		transition: border-radius 0.28s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.nav-shell.is-open {
		border-radius: 1.15rem;
	}

	.nav-shell-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.85rem;
		box-sizing: border-box;
		padding: 0.55rem 0.45rem 0.55rem 0.95rem;
	}

	.nav-toggle {
		all: unset;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.07);
		cursor: pointer;
	}

	.nav-toggle:hover {
		background: rgba(0, 0, 0, 0.11);
	}

	.nav-toggle:focus-visible {
		outline: 1px solid var(--focus);
		outline-offset: 2px;
	}

	.nav-toggle-label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.nav-toggle-icon {
		position: relative;
		display: block;
		width: 0.85rem;
		height: 0.65rem;
	}

	.nav-toggle-line {
		position: absolute;
		left: 0;
		right: 0;
		height: 1.5px;
		background: #232323;
		border-radius: 1px;
		transition:
			transform 0.18s cubic-bezier(0.22, 1, 0.36, 1),
			top 0.18s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.nav-toggle-line-a {
		top: 1px;
	}

	.nav-toggle-line-b {
		top: 8px;
	}

	.nav-toggle.is-open .nav-toggle-line-a {
		top: 4.5px;
		transform: rotate(45deg);
	}

	.nav-toggle.is-open .nav-toggle-line-b {
		top: 4.5px;
		transform: rotate(-45deg);
	}

	.nav-shell-grow {
		display: grid;
		grid-template-rows: 0fr;
		min-width: 0;
		overflow: hidden;
		pointer-events: none;
		transition: grid-template-rows 0.28s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.nav-shell.is-open .nav-shell-grow {
		grid-template-rows: 1fr;
		max-height: min(70svh, 28rem);
		overflow: auto;
		pointer-events: auto;
	}

	.nav-shell-grow-inner {
		min-height: 0;
		overflow: hidden;
	}

	.brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.12rem;
		margin: 0;
		padding: 0;
		border-bottom: none;
		text-align: left;
	}

	.brand-ja {
		display: block;
		font-family: var(--font-serif);
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: 0.06em;
	}

	.brand-en {
		display: block;
		margin: 0;
		padding: 0;
		font-family: var(--font-en);
		font-size: 0.78rem;
		font-weight: 300;
		font-style: italic;
		color: var(--muted);
		letter-spacing: 0.04em;
		line-height: 1.15;
		white-space: nowrap;
	}

	.nav {
		margin: 0;
		padding: 0.15rem 1.15rem 1rem;
	}

	.nav ul {
		display: flex;
		flex-direction: column;
		flex-wrap: nowrap;
		align-items: stretch;
		gap: 0.15rem;
		margin: 0;
		padding: 0;
		list-style: none !important;
		text-align: left;
	}

	.nav li {
		margin: 0;
		padding: 0;
		list-style: none !important;
		text-align: left;
	}

	.nav a {
		display: block;
		margin: 0;
		padding: 0.45rem 0.15rem;
		font-family: var(--font-en);
		font-size: 1.05rem;
		font-weight: 300;
		font-style: normal;
		color: var(--text);
		line-height: 1.35;
		letter-spacing: 0.04em;
		text-align: left;
		border-radius: 0.4rem;
	}

	.nav a:hover {
		color: var(--text);
	}

	.nav a[aria-current='page'] {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 0.28em;
		text-decoration-thickness: 1px;
	}

	.copyright {
		display: none;
		font-family: var(--font-en);
		font-size: 0.72rem;
		font-weight: 300;
		line-height: 1.65;
		color: var(--muted);
		letter-spacing: 0.04em;
	}

	.main {
		padding: 5.25rem var(--page-pad-x) 4.5rem;
		max-width: 44rem;
		margin-inline: 0;
		width: 100%;
	}

	body.is-nav-open {
		overflow: hidden;
	}

	.main[data-home] {
		max-width: 52rem;
	}

	.page-label {
		margin: 0 0 1.75rem;
		padding: 0;
		border-bottom: none;
		font-family: var(--font-en);
		font-size: 1.05rem;
		font-weight: 300;
		font-style: italic;
		color: var(--muted);
		letter-spacing: 0.08em;
		text-align: left;
	}

	.page-lead {
		margin: -0.75rem 0 2.75rem;
		font-size: 0.95rem;
		color: var(--text-secondary);
		max-width: 34em;
		line-height: 1.9;
	}

	.page-lead a {
		text-decoration: underline;
		text-underline-offset: 0.16em;
	}

	.home-figure {
		margin: 0;
		padding: 0;
		background: transparent;
		border: none;
	}

	.home-figure img {
		width: 100%;
		height: auto;
		display: block;
		background: #f3f2f0;
		object-fit: cover;
	}

	.home-caption {
		margin-top: 1.1rem;
		font-family: var(--font-en);
		font-size: 0.85rem;
		font-weight: 300;
		font-style: italic;
		color: var(--muted);
		text-align: right;
		letter-spacing: 0.03em;
	}

	.entry-list {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.entry {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.15rem 0;
		border-bottom: 1px solid var(--line);
	}

	.entry:first-child {
		padding-top: 0;
	}

	.entry:last-child {
		border-bottom: none;
	}

	.entry-meta {
		font-family: var(--font-en);
		font-size: 0.84rem;
		font-weight: 300;
		color: var(--muted);
		letter-spacing: 0.03em;
	}

	.entry-title {
		font-family: var(--font-serif);
		font-size: 1.08rem;
		font-weight: 500;
		line-height: 1.55;
		letter-spacing: 0.02em;
	}

	.entry-sub {
		font-family: var(--font-en);
		font-size: 0.9rem;
		font-weight: 300;
		color: var(--text-secondary);
	}

	.entry-body {
		font-size: 0.95rem;
		color: var(--text-secondary);
	}

	.entry-links {
		font-family: var(--font-en);
		font-size: 0.9rem;
		font-weight: 300;
	}

	.entry-links a {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.entry-links a + a {
		margin-left: 1rem;
	}

	.empty {
		font-family: var(--font-en);
		font-size: 0.98rem;
		font-weight: 300;
		font-style: italic;
		color: var(--muted);
	}

	/* —— news index —— */
	.news-index {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0;
		border-top: 1px solid var(--line);
	}

	.news-index > li {
		border-bottom: 1px solid var(--line);
	}

	.news-index-item {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.15rem;
		padding: 0.85rem 0.15rem;
		color: inherit;
		align-items: baseline;
	}

	.news-index-date {
		font-family: var(--font-en);
		font-size: 0.72rem;
		font-weight: 300;
		letter-spacing: 0.03em;
		color: var(--muted);
		line-height: 1.4;
	}

	.news-index-title {
		font-family: var(--font-serif);
		font-size: 0.9rem;
		font-weight: 400;
		line-height: 1.55;
		letter-spacing: 0.02em;
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.22em;
		text-decoration-thickness: 1px;
		transition: text-decoration-color var(--ease);
	}

	.news-index-item:hover .news-index-title,
	.news-index-item:focus-visible .news-index-title {
		text-decoration-color: currentColor;
	}

	.news-index-item:hover .news-index-date {
		color: var(--text-secondary);
	}

	.news-index-item:focus-visible {
		outline: 1px solid var(--focus);
		outline-offset: 4px;
	}

	/* —— article —— */
	.article {
		max-width: 38rem;
		margin: 0 auto 0 0;
		padding-inline: clamp(0.75rem, 4vw, 1.75rem);
	}

	.article-header {
		margin-bottom: 1.65rem;
	}

	.article-meta-sep {
		margin: 0 0.45rem;
		opacity: 0.5;
	}

	.article-title {
		margin: 0.65rem 0 0;
		font-family: var(--font-serif);
		font-size: 1.15rem;
		font-weight: 500;
		line-height: 1.55;
		letter-spacing: 0.02em;
	}

	.article-hero {
		margin: 0 0 2rem;
		padding: 0;
		background: transparent;
		border: none;
	}

	.article-hero img {
		width: 100%;
		background: #f3f2f0;
	}

	.article-body {
		margin-bottom: 2.5rem;
	}

	.prose {
		font-size: 0.88rem;
		line-height: 1.9;
		color: var(--text);
		overflow-wrap: break-word;
		padding-inline: clamp(0.5rem, 3vw, 1.25rem);
	}

	.prose > *:first-child {
		margin-top: 0;
	}

	.prose > *:last-child {
		margin-bottom: 0;
	}

	.prose :is(p, ul, ol, blockquote, pre, table, figure, hr) {
		margin: 0 0 1.05rem;
	}

	.prose :is(h2, h3, h4) {
		margin: 1.75rem 0 0.75rem;
		font-family: var(--font-serif);
		font-weight: 500;
		line-height: 1.5;
		letter-spacing: 0.02em;
		color: var(--text);
	}

	.prose h2 {
		font-size: 1.02rem;
	}

	.prose h3 {
		font-size: 0.95rem;
	}

	.prose h4 {
		font-size: 0.9rem;
	}

	.prose a {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.prose :is(ul, ol) {
		padding-left: 1.35rem;
		list-style: none !important;
	}

	.prose ul {
		list-style: none !important;
	}

	.prose ol {
		list-style: none !important;
		counter-reset: prose-ol;
	}

	.prose ul > li {
		position: relative;
		padding-left: 0.85rem;
	}

	.prose ul > li::before {
		content: '–' !important;
		display: inline !important;
		position: absolute;
		left: 0;
		width: auto !important;
		height: auto !important;
		color: var(--muted);
		font-family: var(--font-en);
		font-weight: 300;
		background: none !important;
		border: 0 !important;
	}

	.prose ol > li {
		position: relative;
		padding-left: 1.1rem;
		counter-increment: prose-ol;
	}

	.prose ol > li::before {
		content: counter(prose-ol) '.' !important;
		display: inline !important;
		position: absolute;
		left: 0;
		width: auto !important;
		height: auto !important;
		color: var(--muted);
		font-family: var(--font-en);
		font-weight: 300;
		font-size: 0.9em;
		background: none !important;
		border: 0 !important;
	}

	.prose li {
		margin: 0.35rem 0;
	}

	.prose li::marker {
		content: '' !important;
	}

	.prose blockquote {
		padding: 0.15rem 0 0.15rem 1.15rem;
		border-left: 1px solid var(--line-strong);
		color: var(--text-secondary);
	}

	.prose hr {
		border: 0;
		border-top: 1px solid var(--line);
		margin: 2.25rem 0;
	}

	.prose img {
		margin: 0.35rem 0 0.75rem;
		background: #f3f2f0;
	}

	.prose figure {
		margin: 0 0 1.75rem;
	}

	.prose figcaption {
		margin-top: 0.65rem;
		font-family: var(--font-en);
		font-size: 0.82rem;
		font-weight: 300;
		color: var(--muted);
		letter-spacing: 0.03em;
	}

	.prose table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.92rem;
		line-height: 1.7;
	}

	.prose th,
	.prose td {
		padding: 0.7rem 0.85rem;
		border-bottom: 1px solid var(--line);
		text-align: left;
		vertical-align: top;
	}

	.prose th {
		font-weight: 500;
		color: var(--text);
		border-bottom-color: var(--line-strong);
	}

	.prose td {
		color: var(--text-secondary);
	}

	.prose pre,
	.prose code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.86em;
	}

	.prose pre {
		padding: 1rem 1.1rem;
		overflow-x: auto;
		background: #f7f6f4;
		color: var(--text);
		line-height: 1.7;
	}

	.prose :not(pre) > code {
		padding: 0.08em 0.28em;
		background: #f7f6f4;
	}

	.article-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin: 2rem 0 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line);
	}

	.article-nav-link {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		min-width: 0;
		color: inherit;
		transition: opacity var(--ease);
	}

	.article-nav-link:hover {
		opacity: 0.55;
	}

	.article-nav-link.is-newer {
		text-align: right;
		align-items: flex-end;
	}

	.article-nav-link.is-empty {
		visibility: hidden;
		pointer-events: none;
	}

	.article-nav-label {
		font-family: var(--font-en);
		font-size: 0.78rem;
		font-weight: 300;
		letter-spacing: 0.06em;
		color: var(--muted);
	}

	.article-nav-title {
		font-family: var(--font-serif);
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--text-secondary);
	}

	.article-back {
		margin-top: 0.5rem;
		font-family: var(--font-en);
		font-size: 0.9rem;
		font-weight: 300;
		letter-spacing: 0.04em;
	}

	.article-back a {
		color: var(--text-secondary);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.profile-lead {
		margin-bottom: 2.5rem;
		font-size: 1rem;
		color: var(--text-secondary);
		max-width: 32em;
		line-height: 1.95;
