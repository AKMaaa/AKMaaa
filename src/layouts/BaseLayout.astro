---
import '../styles/theme.css';

type NavId =
	| 'home'
	| 'news'
	| 'research'
	| 'works'
	| 'photographs'
	| 'hobbies'
	| 'profile'
	| 'contact';

type Props = {
	title: string;
	description?: string;
	current: NavId;
	pageLabel?: string;
};

const {
	title,
	description = 'Maeda Akira — portfolio, research, and works.',
	current,
	pageLabel,
} = Astro.props;

const nav = [
	{ id: 'news' as const, href: '/news', label: 'news' },
	{ id: 'research' as const, href: '/research', label: 'research' },
	{ id: 'works' as const, href: '/works', label: 'works' },
	{ id: 'photographs' as const, href: '/photographs', label: 'photographs' },
	{ id: 'hobbies' as const, href: '/hobbies', label: 'hobbies' },
	{ id: 'profile' as const, href: '/profile', label: 'profile' },
	{ id: 'contact' as const, href: '/contact', label: 'contact' },
];
---

<!doctype html>
<html lang="ja" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Shippori+Mincho:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="shell">
			<header class="side">
				<div class="brand">
					<a class="brand-ja" href="/">前田 祥</a>
					<p class="brand-en">Maeda Akira</p>
				</div>

				<nav class="nav" aria-label="Primary">
					<ul>
						{
							nav.map((item) => (
								<li>
									<a
										href={item.href}
										aria-current={item.id === current ? 'page' : undefined}
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<p class="copyright">
					Copyright ©<br />
					Maeda Akira<br />
					All rights reserved.
				</p>
			</header>

			<main class="main" data-home={current === 'home' ? '' : undefined}>
				{pageLabel && <h1 class="page-label">{pageLabel}</h1>}
				<slot />
			</main>
		</div>
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	ul,
	ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	p,
	h1,
	h2,
	h3 {
		margin: 0;
	}

	img {
		display: block;
		max-width: 100%;
		height: auto;
	}

	.shell {
		min-height: 100vh;
	}

	.side {
		padding: 2.5rem 1.75rem 2rem 2rem;
	}

	.brand {
		margin-bottom: 2.25rem;
		padding-bottom: 0;
		border-bottom: none;
	}

	.brand-ja {
		display: inline-block;
		font-family: var(--font-serif);
		font-size: 1.4rem;
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: 0.04em;
	}

	.brand-en {
		margin-top: 0.35rem;
		font-family: var(--font-en);
		font-size: 1rem;
		font-weight: 300;
		font-style: italic;
		color: var(--muted);
		letter-spacing: 0.06em;
	}

	.nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem 1.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav li {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav a {
		font-family: var(--font-en);
		font-size: 0.98rem;
		font-weight: 300;
		color: var(--text-secondary);
		line-height: 1.4;
		letter-spacing: 0.04em;
		padding: 0.15rem 0;
	}

	.nav a[aria-current='page'] {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 0.28em;
		text-decoration-thickness: 1px;
	}

	.copyright {
		display: none;
		font-family: var(--font-en);
		font-size: 0.72rem;
		font-weight: 300;
		line-height: 1.65;
		color: var(--muted);
		letter-spacing: 0.04em;
	}

	.main {
		padding: 2rem 1.75rem 4.5rem;
		max-width: 40rem;
	}

	.main[data-home] {
		max-width: 52rem;
	}

	.page-label {
		margin-bottom: 2.5rem;
		padding-bottom: 0;
		border-bottom: none;
		font-family: var(--font-en);
		font-size: 1.05rem;
		font-weight: 300;
		font-style: italic;
		color: var(--muted);
		letter-spacing: 0.08em;
	}

	.page-lead {
		margin: -0.75rem 0 2.75rem;
		font-size: 0.95rem;
		color: var(--text-secondary);
		max-width: 34em;
		line-height: 1.9;
	}

	.page-lead a {
		text-decoration: underline;
		text-underline-offset: 0.16em;
	}

	.home-figure {
		margin: 0;
		padding: 0;
		background: transparent;
		border: none;
	}

	.home-figure img {
		width: 100%;
		background: #f3f2f0;
	}

	.home-caption {
		margin-top: 1.1rem;
		font-family: var(--font-en);
		font-size: 0.85rem;
		font-weight: 300;
		font-style: italic;
		color: var(--muted);
		text-align: right;
		letter-spacing: 0.03em;
	}

	.entry-list {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.entry {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 2rem 0;
		border-bottom: 1px solid var(--line);
	}

	.entry:first-child {
		padding-top: 0;
	}

	.entry:last-child {
		border-bottom: none;
	}

	.entry-meta {
		font-family: var(--font-en);
		font-size: 0.84rem;
		font-weight: 300;
		color: var(--muted);
		letter-spacing: 0.03em;
	}

	.entry-title {
		font-family: var(--font-serif);
		font-size: 1.08rem;
		font-weight: 500;
		line-height: 1.55;
		letter-spacing: 0.02em;
	}

	.entry-sub {
		font-family: var(--font-en);
		font-size: 0.9rem;
		font-weight: 300;
		color: var(--text-secondary);
	}

	.entry-body {
		font-size: 0.95rem;
		color: var(--text-secondary);
	}

	.entry-body :is(p, ul, ol, h2, h3, figure) {
		margin: 0 0 0.65rem;
	}

	.entry-body :is(p, ul, ol, h2, h3, figure):last-child {
		margin-bottom: 0;
	}

	.entry-body img {
		max-width: 100%;
		height: auto;
	}

	.entry-links {
		font-family: var(--font-en);
		font-size: 0.9rem;
		font-weight: 300;
	}

	.entry-links a {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.entry-links a + a {
		margin-left: 1rem;
	}

	.empty {
		font-family: var(--font-en);
		font-size: 0.98rem;
		font-weight: 300;
		font-style: italic;
		color: var(--muted);
	}

	.profile-lead {
		margin-bottom: 2.5rem;
		font-size: 1rem;
		color: var(--text-secondary);
		max-width: 32em;
		line-height: 1.95;
	}

	.social-list {
		display: flex;
		flex-wrap: wrap;
		gap: 1.15rem 1.75rem;
		margin: 0 0 3.5rem;
	}

	.social-list a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-family: var(--font-en);
		font-size: 0.92rem;
		font-weight: 300;
		letter-spacing: 0.04em;
		color: var(--text-secondary);
	}

	.social-list svg {
		width: 0.95rem;
		height: 0.95rem;
		flex-shrink: 0;
	}

	.filter-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		margin: 0 0 2rem;
	}

	.filter-bar button {
		all: unset;
		cursor: pointer;
		font-family: var(--font-en);
		font-size: 0.9rem;
		font-weight: 300;
		letter-spacing: 0.04em;
		color: var(--muted);
		transition: color var(--ease);
	}

	.filter-bar button[aria-pressed='true'] {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 0.28em;
	}

	.filter-bar button:hover {
		color: var(--text);
	}

	.bio-section + .bio-section {
		margin-top: 4rem;
	}

	.bio-section h2 {
		margin-bottom: 1.5rem;
		font-family: var(--font-en);
		font-size: 0.92rem;
		font-weight: 300;
		font-style: italic;
		color: var(--muted);
		letter-spacing: 0.06em;
	}

	.bio-item {
		display: grid;
		grid-template-columns: auto 1fr;
		column-gap: 1rem;
		row-gap: 0.2rem;
		align-items: start;
		padding: 1.5rem 0;
		border-bottom: 1px solid var(--line);
	}

	.bio-item[hidden] {
		display: none;
	}

	.bio-logo {
		width: 2rem;
		height: 2rem;
		object-fit: contain;
		border-radius: 0.2rem;
		background: #fafafa;
		grid-row: 1 / span 5;
		margin-top: 0.15rem;
	}

	.bio-period {
		font-family: var(--font-en);
		font-size: 0.82rem;
		font-weight: 300;
		color: var(--muted);
		grid-column: 2;
	}

	.bio-type {
		font-family: var(--font-en);
		font-size: 0.78rem;
		font-weight: 300;
		letter-spacing: 0.04em;
		color: var(--muted);
		grid-column: 2;
	}

	.bio-role {
		font-size: 1.02rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		grid-column: 2;
	}

	.bio-org {
		font-size: 0.92rem;
		color: var(--text-secondary);
		grid-column: 2;
	}

	.bio-org a {
		text-decoration: underline;
		text-underline-offset: 0.16em;
	}

	.bio-note {
		font-family: var(--font-en);
		font-size: 0.88rem;
		font-weight: 300;
		color: var(--muted);
		grid-column: 2;
	}

	.skill-group + .skill-group {
		margin-top: 1.75rem;
	}

	.skill-category {
		margin-bottom: 0.75rem;
		font-family: var(--font-en);
		font-size: 0.82rem;
		font-weight: 300;
		color: var(--muted);
		letter-spacing: 0.04em;
	}

	.skill-icons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem 1.15rem;
	}

	.skill-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.9rem;
		color: var(--text-secondary);
	}

	.skill-chip img {
		width: 1.05rem;
		height: 1.05rem;
		object-fit: contain;
	}

	.photo-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
	}

	.photo-item figure {
		margin: 0;
		padding: 0;
		background: transparent;
		border: none;
	}

	.photo-item img {
		width: 100%;
	}

	.photo-caption {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.35rem 1rem;
		margin-top: 0.9rem;
		font-family: var(--font-en);
		font-size: 0.85rem;
		font-weight: 300;
		color: var(--muted);
		letter-spacing: 0.03em;
	}

	.photo-caption strong {
		font-weight: 400;
		color: var(--text-secondary);
		font-style: italic;
	}

	.hobby-list .entry-title {
		font-family: var(--font-en);
		font-style: italic;
		font-weight: 400;
	}

	@media (min-width: 768px) {
		.shell {
			display: grid;
			grid-template-columns: var(--side-width) minmax(0, 1fr);
			align-items: start;
		}

		.side {
			position: sticky;
			top: 0;
			display: flex;
			flex-direction: column;
			min-height: 100vh;
			padding: 4.5rem 2.5rem 3rem 3.75rem;
			border-right: none;
			background: #ffffff;
		}

		.brand {
			margin-bottom: 3rem;
		}

		.brand-ja {
			font-size: 1.55rem;
		}

		.nav ul {
			display: flex;
			flex-direction: column;
			flex-wrap: nowrap;
			gap: 1.05rem;
		}

		.copyright {
			display: block;
			margin-top: auto;
			padding-top: 4rem;
		}

		.main {
			padding: 4.5rem 4rem 5.5rem 3.5rem;
			max-width: 42rem;
		}

		.main[data-home] {
			max-width: 56rem;
			padding-right: 5rem;
		}

		.page-label {
			margin-bottom: 3rem;
		}

		.photo-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2.75rem 2rem;
		}

		.bio-item {
			grid-template-columns: 2.25rem 7.5rem 1fr;
			column-gap: 1.25rem;
		}

		.bio-logo {
			grid-row: 1 / span 5;
			grid-column: 1;
		}

		.bio-period {
			grid-column: 2;
			grid-row: 1 / span 5;
			padding-top: 0.2rem;
		}

		.bio-type,
		.bio-role,
		.bio-org,
		.bio-note {
			grid-column: 3;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			transition: none !important;
		}
	}
</style>
