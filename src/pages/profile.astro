---
import {
	career,
	careerFilters,
	careerTypeLabels,
	orgLogoUrl,
	profileSummary,
	skillImageUrl,
	skills,
	socials,
	type CareerType,
} from '../data/bio';
import BaseLayout from '../layouts/BaseLayout.astro';

const visibleSocials = socials.filter((s) => s.url.length > 0);

const icons: Record<(typeof socials)[number]['id'], string> = {
	researchmap: `<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>`,
	github: `<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8c.85 0 1.71.11 2.51.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.76c0 .26.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>`,
	facebook: `<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.3-1.5 1.6-1.5H16.8V4.6c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.2H8.2V14h2.5v8h2.8Z"/></svg>`,
};
---

<BaseLayout
	title="profile | Maeda Akira"
	description="前田 祥（Maeda Akira）のプロフィール"
	current="profile"
	pageLabel="profile"
>
	<section class="profile-lead">
		<p>{profileSummary.lead}</p>
	</section>

	{
		visibleSocials.length > 0 && (
			<ul class="social-list" aria-label="External profiles">
				{visibleSocials.map((item) => (
					<li>
						<a href={item.url} target="_blank" rel="noopener noreferrer">
							<span set:html={icons[item.id]} />
							<span>{item.label}</span>
						</a>
					</li>
				))}
			</ul>
		)
	}

	<section class="bio-section" aria-labelledby="career-heading">
		<h2 id="career-heading">career</h2>

		<div class="filter-bar" role="group" aria-label="経歴の種類で絞り込む">
			{
				careerFilters.map((key) => (
					<button type="button" data-filter={key} aria-pressed={key === 'all' ? 'true' : 'false'}>
						{careerTypeLabels[key]}
					</button>
				))
			}
		</div>

		<ul id="career-list">
			{
				career.map((item) => {
					const logo = orgLogoUrl(item);

					return (
						<li class="bio-item" data-type={item.type}>
							{logo ? (
								<img
									class="bio-logo"
									src={logo}
									alt=""
									width="32"
									height="32"
									loading="lazy"
								/>
							) : (
								<span class="bio-logo" aria-hidden="true" />
							)}
							<p class="bio-period">{item.period}</p>
							<p class="bio-type">{careerTypeLabels[item.type as CareerType]}</p>
							<p class="bio-role">{item.role}</p>
							<p class="bio-org">
								{item.orgUrl ? (
									<a href={item.orgUrl} target="_blank" rel="noopener noreferrer">
										{item.org}
									</a>
								) : (
									item.org
								)}
							</p>
							{item.note && <p class="bio-note">{item.note}</p>}
						</li>
					);
				})
			}
		</ul>
	</section>

	<section class="bio-section" aria-labelledby="skills-heading">
		<h2 id="skills-heading">skills</h2>
		{
			skills.map((group) => (
				<div class="skill-group">
					<p class="skill-category">{group.category}</p>
					<ul class="skill-icons">
						{group.items.map((skill) => {
							const iconSrc = skillImageUrl(skill);
							return (
								<li class="skill-chip">
									{iconSrc && (
										<img
											src={iconSrc}
											alt=""
											width="18"
											height="18"
											loading="lazy"
										/>
									)}
									<span>{skill.name}</span>
								</li>
							);
						})}
					</ul>
				</div>
			))
		}
	</section>
</BaseLayout>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-bar button');
	const items = document.querySelectorAll<HTMLElement>('#career-list .bio-item');

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const filter = button.dataset.filter ?? 'all';

			buttons.forEach((b) => b.setAttribute('aria-pressed', b === button ? 'true' : 'false'));

			items.forEach((item) => {
				const type = item.dataset.type;
				item.hidden = filter !== 'all' && type !== filter;
			});
		});
	});
</script>
