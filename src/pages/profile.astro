---
import {
	career,
	careerFilters,
	careerTypeLabels,
	orgLogoUrl,
	profileSummary,
	skillImageUrl,
	skills,
	socials,
	type CareerType,
} from '../data/bio';
import BaseLayout from '../layouts/BaseLayout.astro';

const visibleSocials = socials.filter((s) => s.url.length > 0);
---

<BaseLayout
	title="profile | Maeda Akira"
	description="前田 祥（Maeda Akira）のプロフィール"
	current="profile"
	pageLabel="profile"
>
	<section class="profile-lead">
		<p>{profileSummary.lead}</p>
	</section>

	{
		visibleSocials.length > 0 && (
			<ul class="social-list" aria-label="External profiles">
				{visibleSocials.map((item) => (
					<li>
						<a href={item.url} target="_blank" rel="noopener noreferrer">
							{item.label}
						</a>
					</li>
				))}
			</ul>
		)
	}

	<section class="bio-section" aria-labelledby="career-heading">
		<h2 id="career-heading">career</h2>

		<div class="filter-bar" role="group" aria-label="経歴の種類で絞り込む">
			{
				careerFilters.map((key) => (
					<button type="button" data-filter={key} aria-pressed={key === 'all' ? 'true' : 'false'}>
						{careerTypeLabels[key]}
					</button>
				))
			}
		</div>

		<ul id="career-list">
			{
				career.map((item) => {
					const logo = orgLogoUrl(item);

					return (
						<li class="bio-item" data-type={item.type}>
							{logo ? (
								<img
									class="bio-logo"
									src={logo}
									alt=""
									width="32"
									height="32"
									loading="lazy"
								/>
							) : (
								<span class="bio-logo" aria-hidden="true" />
							)}
							<p class="bio-period">{item.period}</p>
							<p class="bio-type">{careerTypeLabels[item.type as CareerType]}</p>
							<p class="bio-role">{item.role}</p>
							<p class="bio-org">
								{item.orgUrl ? (
									<a href={item.orgUrl} target="_blank" rel="noopener noreferrer">
										{item.org}
									</a>
								) : (
									item.org
								)}
							</p>
							{item.note && <p class="bio-note">{item.note}</p>}
						</li>
					);
				})
			}
		</ul>
	</section>

	<section class="bio-section" aria-labelledby="skills-heading">
		<h2 id="skills-heading">skills</h2>
		{
			skills.map((group) => (
				<div class="skill-group">
					<p class="skill-category">{group.category}</p>
					<ul class="skill-icons">
						{group.items.map((skill) => {
							const iconSrc = skillImageUrl(skill);
							return (
								<li class="skill-chip">
									{iconSrc && (
										<img
											src={iconSrc}
											alt=""
											width="18"
											height="18"
											loading="lazy"
										/>
									)}
									<span>{skill.name}</span>
								</li>
							);
						})}
					</ul>
				</div>
			))
		}
	</section>
</BaseLayout>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-bar button');
	const items = document.querySelectorAll<HTMLElement>('#career-list .bio-item');

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const filter = button.dataset.filter ?? 'all';

			buttons.forEach((b) => b.setAttribute('aria-pressed', b === button ? 'true' : 'false'));

			items.forEach((item) => {
				const type = item.dataset.type;
				item.hidden = filter !== 'all' && type !== filter;
			});
		});
	});
</script>
