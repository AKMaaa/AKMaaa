---
import { contactEmail } from '../data/bio';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="contact | Maeda Akira"
	description="前田 祥（Maeda Akira）への連絡先"
	current="contact"
	pageLabel="contact"
>
	<div class="contact-intro">
		<a class="mail" href={`mailto:${contactEmail}`}>{contactEmail}</a>
	</div>

	<form
		class="contact-form"
		action={`https://formsubmit.co/${contactEmail}`}
		method="POST"
	>
		<input type="hidden" name="_subject" value="Portfolio contact — Maeda Akira" />
		<input type="hidden" name="_template" value="table" />
		<input type="hidden" name="_captcha" value="false" />
		<input
			type="text"
			name="_honey"
			class="honey"
			tabindex="-1"
			autocomplete="off"
			aria-hidden="true"
		/>

		<label>
			<span>name</span>
			<input type="text" name="name" required autocomplete="name" placeholder="Your name" />
		</label>

		<label>
			<span>email</span>
			<input
				type="email"
				name="email"
				required
				autocomplete="email"
				placeholder="you@example.com"
			/>
		</label>

		<label>
			<span>message</span>
			<textarea name="message" rows="6" required placeholder="Message"></textarea>
		</label>

		<div class="actions">
			<button type="submit">send</button>
		</div>
	</form>
</BaseLayout>
