---
import { withBase } from '../library/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Maeda Akira"
	description="前田 祥（Maeda Akira）のポートフォリオ"
	current="home"
>
	<figure class="home-figure">
		<img
			src={withBase('/images/home-hero.webp')}
			alt="煙のような表現の紫陽花"
			width="1024"
			height="682"
		/>
		<figcaption class="home-caption">Hydrangea</figcaption>
	</figure>
</BaseLayout>
