---
import { photographs } from '../data/photographs';
import { withBase } from '../library/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="photographs | Maeda Akira"
	description="Maeda Akira の写真"
	current="photographs"
	pageLabel="photographs"
>
	<ul class="photo-grid">
		{
			photographs.map((photo) => {
				const portrait = photo.height > photo.width;
				const classes = [
					'photo-item',
					photo.featured ? 'is-featured' : '',
					portrait ? 'is-portrait' : '',
				]
					.filter(Boolean)
					.join(' ');

				return (
					<li class={classes}>
						<figure>
							<img
								src={withBase(photo.src)}
								alt={photo.alt}
								width={photo.width}
								height={photo.height}
								loading="lazy"
								decoding="async"
							/>
							<figcaption class="photo-caption">
								<strong>{photo.title}</strong>
								<span>
									{[photo.place, photo.year].filter(Boolean).join(' / ')}
								</span>
							</figcaption>
						</figure>
					</li>
				);
			})
		}
	</ul>
</BaseLayout>
